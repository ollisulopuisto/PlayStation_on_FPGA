circuit p13 {
	input din<8>;
	instrin start;
	output busy, dout<8>;
	reg_wr acc<8>;
	reg_wr dreg<8>;
	stage_name work { task do(dreg); }
	instr_arg start(din);
	instruct start generate work.do(din);
	busy = work.do;
	dout = acc;
	stage work {
		state_name s0, s1;
		first_state s0;
		state s0 par { acc := dreg; goto s1; }
		state s1 par { acc := acc + 0x01; goto s0; finish; }
	}
}
